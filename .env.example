# 디스코드 개발자 포털(https://discord.com/developers/applications)에서 발급
DISCORD_TOKEN=여기에_봇_토큰
CLIENT_ID=여기에_애플리케이션(클라이언트)_ID

# 슬래시 명령어를 특정 서버에만 즉시 등록하고 싶을 때 (선택, 테스트용 권장)
# 비워두면 전역 등록(반영까지 최대 1시간 소요)
GUILD_ID=여기에_테스트_서버_ID

# Lavalink 서버 접속 정보 (아래 application.yml 과 일치해야 함)
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
